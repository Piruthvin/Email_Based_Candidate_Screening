# ==============================================================================
# Email Based Candidate Screening Backend - Environment Configuration Template
# ==============================================================================

# --- Application Core ---
APP_NAME=Email Based Candidate Screening Backend
# development | staging | production
APP_ENV=development
# Set false in production
DEBUG=true
# Bind address
HOST=0.0.0.0
# HTTP port
PORT=8000
# Public base URL for generated report download links
# Local: PUBLIC_BASE_URL=http://localhost:8000
# Azure: PUBLIC_BASE_URL=https://<azure-container-app-fqdn>
PUBLIC_BASE_URL=http://localhost:8000
# Allowed CORS origins
CORS_ORIGINS=["*"]

# --- PostgreSQL Database (Required in production; defaults to localhost/remote) ---
POSTGRES_DB=talentpool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional direct URL; if empty, assembled from POSTGRES_*
DATABASE_URL=

# --- Ingestion & Resume Limits ---
# Maximum allowable size in MB for resume uploads/attachments
MAX_RESUME_MB=10
# Default country code for phone normalization
DEFAULT_COUNTRY=IN

# --- Microsoft Graph API (Mailbox Sync - Optional for local dev; warns gracefully if empty) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX_UPN=

# --- Recruiter Agent (iGentic Platform - Real Credentials) ---
IGENTIC_EXECUTOR_URL=
IGENTIC_APP_ID=iGentic-2.0
IGENTIC_API_KEY=
IGENTIC_BEARER_TOKEN=
IGENTIC_USERNAME=

# --- Scoring Agent Connectivity Mode ---
# fake | igentic
SCORING_AGENT_MODE=fake

# --- Scoring Agent via iGentic (Populate if SCORING_AGENT_MODE=igentic) ---
SCORING_IGENTIC_EXECUTOR_URL=
SCORING_IGENTIC_APP_ID=
SCORING_IGENTIC_API_KEY=
SCORING_IGENTIC_BEARER_TOKEN=
SCORING_IGENTIC_USERNAME=

# --- Queue Workers, Retries & Cost Circuit Breaker ---
QUEUE_POLL_INTERVAL_SECONDS=2
MAX_JOB_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=300
